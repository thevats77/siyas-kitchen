generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id                    String   @id @default(cuid())
  customerName          String?
  itemsOrdered          String
  amount                Float
  source                String
  paymentMethod         String
  expenseAmount         Float?
  expensePaymentMethod  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
